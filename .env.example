# Скопируйте в .env для локального запуска. Не коммитьте .env.

# Telegram: бот от @BotFather и ID чата, где бот запущен
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Supabase: Project Settings → API (нужен service_role, не anon)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Сайты клиентов — вместо sites.json (в GitHub — секрет SITES_JSON)
# SITES_JSON={"sites":[{"id":"client","name":"Клиент","url":"https://client.kz","expectText":"Каталог"}]}

# Сценарии на staging клиента (только с письменного разрешения)
# TARGET_URL=https://staging.client.kz

# Часовой пояс для отчётов и напоминаний
# REPORT_TZ=Asia/Almaty
